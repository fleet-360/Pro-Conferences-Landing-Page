# Copy to .env and fill in. Without SMTP_HOST the server only prints emails (dry-run).
PORT=5510

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=you@example.com
# For Gmail use an App Password, not the account password
SMTP_PASS=
MAIL_FROM="Pro Algorithm <you@example.com>"
